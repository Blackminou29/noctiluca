<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Les droits de Noctiluca sous le « runtime renforcé » qu'exige la
  notarisation d'Apple. Sans eux, une application signée ne pourrait plus
  écouter un son : numba compile les boucles du moteur d'écoute pendant
  que l'application tourne, et écrit donc du code exécutable en mémoire.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Python charge ses bibliothèques depuis le paquet, signées par
         leurs auteurs et non par l'éditeur de Noctiluca. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
